@page "/"
@attribute [StreamRendering]
@inject FileService FileService;

<h1>In Progress</h1>
<br />

@if (list is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Striped="true" />
}
else
{
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-6">
        <MudTextField @bind-Value="SearchString" Immediate="true" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
            IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="cover-search" />
    </MudStack>

    @if (Filtered.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No titles found.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var item in Paged)
            {
                <MudItem xs="6" sm="4" md="3" lg="2" Class="d-flex">
                    <MudCard Class="cover-card" Elevation="2">
                        <div class="cover-card-media" @onclick="@(() => OpenImage(item))">
                            <MudImage Src="@GetImagePath(item)" Alt=" " ObjectFit="ObjectFit.Cover" />
                            <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(item.Type)" Variant="Variant.Filled"
                                Class="cover-card-type">@item.Type</MudChip>
                        </div>
                        <MudCardContent Class="cover-card-content">
                            <MudText Typo="Typo.subtitle2" Class="cover-card-title" title="@item.Name">@item.Name</MudText>
                            <MudText Typo="Typo.caption" Class="cover-card-progress">
                                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                                @GetProgressLabel(item)
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2" Class="cover-pager mt-6 flex-wrap">
        <MudText Typo="Typo.body2" Class="cover-card-count">@GetCountLabel()</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="cover-pager-controls">
            <MudSelect T="int" Value="pageSize" ValueChanged="OnPageSizeChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="Per page">
                @foreach (var size in pageSizeOptions)
                {
                    <MudSelectItem T="int" Value="@size">@GetPageSizeLabel(size)</MudSelectItem>
                }
            </MudSelect>

            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Medium" Disabled="@(CurrentPage == 0)" OnClick="PreviousPage"
                aria-label="Previous page" />
            <MudText Typo="Typo.body2" Class="cover-card-count">@($"{CurrentPage + 1} / {TotalPages}")</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" Disabled="@(CurrentPage >= TotalPages - 1)"
                OnClick="NextPage" aria-label="Next page" />
        </MudStack>
    </MudStack>

    <MudDialog @bind-Visible="isImageVisible" Options="imageDialogOptions" Class="cover-dialog" ContentClass="cover-dialog-content">
        <TitleContent>
            <MudText Typo="Typo.subtitle1" Class="cover-preview-title">@selected?.Name</MudText>
        </TitleContent>
        <DialogContent>
            @if (selected is not null)
            {
                <div class="cover-preview" @onclick="@(() => isImageVisible = false)">
                    <MudImage Src="@GetImagePath(selected)" Alt=" "></MudImage>
                </div>
            }
        </DialogContent>
    </MudDialog>
}

@code
{
    private List<InProgress>? list;
    private InProgress? selected;
    private string searchString = "";
    private bool isImageVisible;

    private readonly DialogOptions imageDialogOptions = new()
    {
        MaxWidth = MaxWidth.False,
        NoHeader = false,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    private int page;
    private int pageSize = 12;
    private static readonly int[] pageSizeOptions = [12, 24, 48, int.MaxValue];

    private string SearchString
    {
        get => searchString;
        set
        {
            searchString = value;
            page = 0;
        }
    }

    private List<InProgress> Filtered => list?.Where(FilterFunc1).ToList() ?? [];

    private int TotalPages
    {
        get
        {
            int count = Filtered.Count;

            if (count == 0 || pageSize <= 0)
                return 1;

            return (int)Math.Ceiling(count / (double)pageSize);
        }
    }

    private int CurrentPage => Math.Clamp(page, 0, TotalPages - 1);

    private List<InProgress> Paged => Filtered.Skip(CurrentPage * pageSize).Take(pageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        list = await FileService.ReadInProgressFileAsync();
    }

    private string GetImagePath(InProgress context)
    {
        string? type = context.Type.ToLower();
        string? fileName = context.ImageUrl;

        return $"images/{type}/{fileName}";
    }

    private static Color GetTypeColor(string type) => type.ToLower() switch
    {
        "anime" => Color.Primary,
        "book" => Color.Success,
        "manga" => Color.Secondary,
        "movie" => Color.Warning,
        "series" => Color.Info,
        "game" => Color.Tertiary,
        _ => Color.Default
    };

    private static string GetProgressLabel(InProgress context) => context.Type.ToLower() switch
    {
        "anime" => $"Episode {context.Progress}",
        "series" => context.Progress,
        "manga" => $"Chapter {context.Progress}",
        "book" => $"Page {context.Progress}",
        _ => context.Progress
    };

    private string GetCountLabel() => $"Showing {Paged.Count} of {list?.Count ?? 0} records.";

    private static string GetPageSizeLabel(int size) => size == int.MaxValue ? "All" : size.ToString();

    private void OnPageSizeChanged(int value)
    {
        pageSize = value;
        page = 0;
    }

    private void PreviousPage() => page = Math.Max(0, CurrentPage - 1);

    private void NextPage() => page = Math.Min(TotalPages - 1, CurrentPage + 1);

    private void OpenImage(InProgress context)
    {
        selected = context;
        isImageVisible = true;
    }

    private bool FilterFunc1(InProgress element) => FilterFunc(element, searchString);

    private bool FilterFunc(InProgress element, string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return true;
        if (element.Name.Contains(input, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }
}