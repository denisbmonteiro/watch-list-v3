@page "/serie"
@attribute [StreamRendering]
@inject FileService FileService;

<h1>Series</h1>
<br />

@if (list is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Striped="true" />
}
else
{
    <MudTable Items="@list" Hover="true" Dense="true" Bordered="true" Breakpoint="Breakpoint.None" Filter="new Func<Serie,bool>(FilterFunc1)">
        <ToolBarContent>
            <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>

        <HeaderContent>
            <MudTh Class="text-center w-10">#</MudTh>
            <MudTh Class="text-center w-15">Image</MudTh>
            <MudTh>Name</MudTh>
            <MudTh Class="text-center w-10">Progress</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd Class="text-center">@GetRowNumber(context)</MudTd>
            <MudTd Class="text-center">
                <div class="cover-thumbnail" @onclick="@(() => OpenImage(context))">
                    <MudImage Src="@GetImagePath(context)" Alt=" " Width="80" Height="120" ObjectFit="ObjectFit.Cover" Style="border-radius: 4px;"></MudImage>
                </div>
            </MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd Class="text-center">@context.Progress</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 20, 50, 100, int.MaxValue }" />
        </PagerContent>
    </MudTable>

    <MudDialog @bind-Visible="isImageVisible" Options="imageDialogOptions" Class="cover-dialog" ContentClass="cover-dialog-content">
        <TitleContent>
            <MudText Typo="Typo.subtitle1" Class="cover-preview-title">@selected?.Name</MudText>
        </TitleContent>
        <DialogContent>
            @if (selected is not null)
            {
                <div class="cover-preview" @onclick="@(() => isImageVisible = false)">
                    <MudImage Src="@GetImagePath(selected)" Alt=" "></MudImage>
                </div>
            }
        </DialogContent>
    </MudDialog>
}

@code
{
    private List<Serie>? list;
    private Serie? selected;
    private string searchString = "";
    private bool isImageVisible;

    private readonly DialogOptions imageDialogOptions = new()
    {
        MaxWidth = MaxWidth.False,
        NoHeader = false,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        list = await FileService.ReadSerieFileAsync();
    }

    protected int GetRowNumber(Serie context)
    {
        if (list is null)
            return 0;

        return list.IndexOf(context) + 1;
    }

    private string GetImagePath(Serie context)
    {
        return $"images/series/{context.ImageUrl}";
    }

    private void OpenImage(Serie context)
    {
        selected = context;
        isImageVisible = true;
    }

    private bool FilterFunc1(Serie element) => FilterFunc(element, searchString);

    private bool FilterFunc(Serie element, string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return true;
        if (element.Name.Contains(input, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }
}