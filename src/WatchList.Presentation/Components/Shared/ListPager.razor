<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2" Class="cover-pager mt-6 flex-wrap">
    <MudText Typo="Typo.body2" Class="cover-card-count">@($"Showing {ShownCount} of {TotalCount} records.")</MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="cover-pager-controls">
        <MudSelect T="int" Value="PageSize" ValueChanged="PageSizeChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="Per page">
            @foreach (var size in PageSizeOptions)
            {
                <MudSelectItem T="int" Value="@size">@GetPageSizeLabel(size)</MudSelectItem>
            }
        </MudSelect>

        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Medium" Disabled="@(PageIndex == 0)" OnClick="() => PageIndexChanged.InvokeAsync(PageIndex - 1)"
            aria-label="Previous page" />
        <MudText Typo="Typo.body2" Class="cover-card-count">@($"{PageIndex + 1} / {TotalPages}")</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" Disabled="@(PageIndex >= TotalPages - 1)"
            OnClick="() => PageIndexChanged.InvokeAsync(PageIndex + 1)" aria-label="Next page" />
    </MudStack>
</MudStack>

@code
{
    /// <summary><see cref="int.MaxValue"/> is the "All" option, the same value as <c>PageRequest.All</c>.</summary>
    public static IReadOnlyList<int> PageSizeOptions { get; } = [12, 24, 48, int.MaxValue];

    /// <summary>Zero-based.</summary>
    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public EventCallback<int> PageIndexChanged { get; set; }

    [Parameter]
    public int TotalPages { get; set; }

    [Parameter]
    public int PageSize { get; set; }

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>Items on the current page.</summary>
    [Parameter]
    public int ShownCount { get; set; }

    /// <summary>Items in the whole list, before the search.</summary>
    [Parameter]
    public int TotalCount { get; set; }

    private static string GetPageSizeLabel(int size) => size == int.MaxValue ? "All" : size.ToString(CultureInfo.InvariantCulture);
}
