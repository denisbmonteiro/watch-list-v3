@page "/queue"
@attribute [StreamRendering]
@inject IQueryHandler<GetQueueQuery, IReadOnlyList<QueueItemDto>> GetQueue

<h1>Queue</h1>
<br />

<TitleTable Items="_items" Title="item => item.Title" Type="item => item.MediaType.ToString()" />

@code
{
    private IReadOnlyList<QueueItemDto>? _items;

    protected override async Task OnInitializedAsync() =>
        _items = await GetQueue.HandleAsync(new GetQueueQuery(), CancellationToken.None);
}
