@page "/dashboard"
@attribute [StreamRendering]
@inject IQueryHandler<GetDashboardSummaryQuery, DashboardSummaryDto> GetDashboardSummary

<h1>Dashboard</h1>
<br />

@if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Striped="true" />
}
else
{
    <MudGrid Class="mb-5">
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-center" Style="height: 100px;">
                <MudText Typo="Typo.h5">In Progress: @_summary.InProgress</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-center" Style="height: 100px;">
                <MudText Typo="Typo.h5">Anime: @_summary.Anime</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="12" md="4">
            <MudPaper Elevation="2" Class="pa-4 d-flex align-center justify-center" Style="height: 100px;">
                <MudText Typo="Typo.h5">Movie: @_summary.Movie</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4">
        @if (_selectedIndex >= 0)
        {
            <MudText Typo="Typo.h5" Class="text-center mb-2">@($"{_labels[_selectedIndex]}: {_counts[_selectedIndex]}")</MudText>
        }

        <div class="dashboard-chart">
            <MudChart T="double" ChartType="ChartType.Pie" ChartSeries="@_series" @bind-SelectedIndex="_selectedIndex" ChartLabels="@_labels" Width="300px" Height="300px" />
        </div>
    </MudPaper>
}

@code
{
    private DashboardSummaryDto? _summary;
    private string[] _labels = [];
    private double[] _counts = [];
    private List<ChartSeries<double>> _series = [];
    private int _selectedIndex = -1;

    protected override async Task OnInitializedAsync()
    {
        var summary = await GetDashboardSummary.HandleAsync(new GetDashboardSummaryQuery(), CancellationToken.None);

        (string Label, int Count)[] slices =
        [
            ("In Progress", summary.InProgress),
            ("Anime", summary.Anime),
            ("Book", summary.Book),
            ("Game", summary.Game),
            ("Manga", summary.Manga),
            ("Movie", summary.Movie),
            ("Queue", summary.Queue),
            ("Serie", summary.Series),
        ];

        _labels = [.. slices.Select(slice => slice.Label)];
        _counts = [.. slices.Select(slice => (double)slice.Count)];
        _series = [new ChartSeries<double> { Data = _counts }];
        _summary = summary;
    }
}
