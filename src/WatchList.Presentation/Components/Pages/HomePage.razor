@page "/"
@attribute [StreamRendering]
@inject IQueryHandler<GetInProgressPageQuery, PagedResult<InProgressItemDto>> GetInProgressPage

<h1>In Progress</h1>
<br />

<CoverGrid TItem="InProgressItemDto" Load="LoadAsync" Title="item => item.Title" CoverUrl="item => item.CoverUrl">
    <Badge>
        <MudChip T="string" Size="Size.Small" Color="@MediaTypeColors.For(context.MediaType)" Variant="Variant.Filled"
            Class="cover-card-type">@context.MediaType</MudChip>
    </Badge>
    <Details>
        <MudText Typo="Typo.caption" Class="cover-card-progress">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
            @ProgressLabelFormatter.Format(context.Progress, context.ProgressUnit)
        </MudText>
    </Details>
</CoverGrid>

@code
{
    private Task<PagedResult<InProgressItemDto>> LoadAsync(string? search, PageRequest page, CancellationToken cancellationToken) =>
        GetInProgressPage.HandleAsync(new(search, page), cancellationToken);
}
