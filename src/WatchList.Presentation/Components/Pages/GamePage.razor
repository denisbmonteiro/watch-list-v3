@page "/game"
@attribute [StreamRendering]
@inject IQueryHandler<GetCatalogPageQuery, PagedResult<CatalogItemDto>> GetCatalogPage

<h1>Games</h1>
<br />

<TitleTable Items="_items" Title="item => item.Title" />

@code
{
    private IReadOnlyList<CatalogItemDto>? _items;

    protected override async Task OnInitializedAsync() =>
        _items = (await GetCatalogPage.HandleAsync(new(MediaType.Game, null, PageRequest.All), CancellationToken.None)).Items;
}
