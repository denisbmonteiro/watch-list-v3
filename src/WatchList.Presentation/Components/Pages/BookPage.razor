@page "/book"
@attribute [StreamRendering]
@inject IQueryHandler<GetCatalogPageQuery, PagedResult<CatalogItemDto>> GetCatalogPage

<h1>Books</h1>
<br />

<CoverGrid TItem="CatalogItemDto" Load="LoadAsync" Title="item => item.Title" CoverUrl="item => item.CoverUrl"
    PlaceholderIcon="@Icons.Material.Filled.MenuBook" TitleIcon="@Icons.Material.Filled.MenuBook">
    <Details>
        <MudText Typo="Typo.caption" Class="cover-card-progress" title="@context.Author">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            @context.Author
        </MudText>
    </Details>
</CoverGrid>

@code
{
    private Task<PagedResult<CatalogItemDto>> LoadAsync(string? search, PageRequest page, CancellationToken cancellationToken) =>
        GetCatalogPage.HandleAsync(new(MediaType.Book, search, page), cancellationToken);
}
